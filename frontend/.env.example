# Copy to frontend/.env.local. Everything here ends up in the PUBLIC website bundle.
# Only put public values here. Never the service-role key.

VITE_SUPABASE_URL=
# The "anon" / "publishable" key. Safe in the browser because RLS protects data.
VITE_SUPABASE_ANON_KEY=

# FastAPI base URL
VITE_API_URL=http://localhost:8000

# true = use data/mock JSON for everything (no Supabase or backend needed)
VITE_USE_MOCKS=true
