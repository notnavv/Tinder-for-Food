# Copy to backend/.env and fill in. NEVER commit backend/.env.
# Get these from whoever manages the team's Supabase project (Dashboard -> Project Settings -> API).

APP_ENV=development

# Supabase project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# Server-only key. Bypasses Row Level Security. Backend + ingestion scripts ONLY.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173

# When true, ML endpoints return data from data/mock/ instead of real models.
# Lets the frontend integrate before the models exist.
USE_MOCK_DATA=true

# Ingestion safety gate. Keep false until UCLA's terms/permission are reviewed.
# Even when true, the ingest script still requires --allow-network.
ALLOW_UCLA_SCRAPING=false
